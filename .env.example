# Environment config - copy to .env.local and adjust
NEXT_PUBLIC_DM_DEV=true
NEXT_PUBLIC_DM_LOCK=false
# This season's actual hike date (YYYY-MM-DD) - every age-based validation rule in
# src/utils/validation.ts is computed against this. Required; the app fails to load
# without it. Update this every season - see TODO.md.
NEXT_PUBLIC_DM_HIKE_DATE=2026-10-03
DM_DEV=true
DM_BANKDETS="A/C: XXX S/C: XXX"

# Cognito (run scripts/create-cognito-pool.js dev to provision, then fill these in)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=eu-west-2
